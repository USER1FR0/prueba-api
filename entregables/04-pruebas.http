  "curp":"RADL150101HGTXYZ09","rfc":"RADL1501019D4","sexo":"MASCULINO","nacionalidad":"Mexicana","estadoCivil":"SOLTERO",
  "correo":"luis@example.com","telefonoMovil":"4771112222","ocupacion":"Est","empresa":"N","ingresoMensual":1000,
  "domicilio":{"calle":"C1","numeroExterior":"10","colonia":"Centro","municipio":"Leon","estado":"GUANAJUATO","codigoPostal":"37000","pais":"Mexico"} }

